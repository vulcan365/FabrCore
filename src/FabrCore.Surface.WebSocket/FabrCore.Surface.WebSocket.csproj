<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>FabrCore Surface over WebSocket</Title>
    <Description>Surface's chat for Blazor Server apps that reach a FabrCore host over its /ws, without an Orleans cluster connection.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FabrCore.Surface\FabrCore.Surface.csproj" />
    <ProjectReference Include="..\FabrCore.Client.WebSocket\FabrCore.Client.WebSocket.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FabrCore.Surface.WebSocket.Tests" />
  </ItemGroup>
</Project>
