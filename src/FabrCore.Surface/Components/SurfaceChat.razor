@inject ISurfacePrincipalContextProvider PrincipalContextProvider
@inject SurfaceWorkspaceService Workspace
@inject Microsoft.Extensions.Options.IOptions<SurfaceOptions> SurfaceOptions
@inject IJSRuntime JSRuntime
@inject ILogger<SurfaceChat> Logger
@implements IAsyncDisposable
@* A chat with one agent that fills the space it's given, for a page of its own rather than a popup (SurfaceChatLink). The history reads
   like a team chat: who said it and when, grouped by sender and day, with the agent's progress while it works. *@

<section class="surface-chat @CssClass" aria-label="@DisplayTitle">
    <header class="surface-chat-header">
        <span class="surface-chat-avatar is-agent" aria-hidden="true">
            <i class="@Icon"></i>
            <span class="surface-chat-presence @PresenceClass"></span>
        </span>
        <div class="surface-chat-heading">
            <h2 class="surface-chat-title">@DisplayTitle</h2>
            <div class="surface-chat-status">
                <span>@PresenceText</span>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <span class="surface-chat-subtitle">@Subtitle</span>
                }
            </div>
        </div>
        <div class="surface-chat-header-actions">
            @HeaderActions
            @if (AllowNewConversation && _state == ChatState.Ready)
            {
                <button type="button"
                        class="surface-chat-button"
                        title="Start a new conversation. The agent forgets this one."
                        disabled="@_resetting"
                        @onclick="NewConversationAsync">
                    <i class="bi bi-plus-lg"></i><span>New conversation</span>
                </button>
            }
        </div>
    </header>

    @if (_state == ChatState.Connecting)
    {
        <div class="surface-chat-center" role="status">
            <span class="surface-chat-spinner" aria-hidden="true"></span>
            <p>@LoadingMessage</p>
        </div>
    }
    else if (_state == ChatState.Problem && _problem is not null)
    {
        <div class="surface-chat-center surface-chat-problem" role="alert">
            <i class="bi @(_problem.Problem is SurfaceConnectionProblem.AgentMissing or SurfaceConnectionProblem.NotConfigured ? "bi-plug" : "bi-exclamation-circle")" aria-hidden="true"></i>
            <h3>@_problem.Title</h3>
            <p>@_problem.Message</p>
            @ProblemActions
            <button type="button" class="surface-chat-button" disabled="@_retrying" @onclick="RetryAsync">
                <i class="bi bi-arrow-clockwise"></i><span>Try again</span>
            </button>
        </div>
    }
    else
    {
        var items = VisibleItems;
        var (waiting, progress) = Activity;
        <div class="surface-chat-body">
            <div class="surface-chat-scroll" @ref="_timelineRef" aria-live="polite">
                <div class="surface-chat-thread">
                    @if (items.Count == 0 && !waiting)
                    {
                        <div class="surface-chat-welcome">
                            <span class="surface-chat-avatar is-agent is-large" aria-hidden="true"><i class="@Icon"></i></span>
                            <h3>@(WelcomeTitle ?? $"Chat with {DisplayTitle}")</h3>
                            <p>@WelcomeMessage</p>
                            @if (Suggestions is { Count: > 0 })
                            {
                                <div class="surface-chat-suggestions">
                                    @foreach (var suggestion in Suggestions)
                                    {
                                        <button type="button" class="surface-chat-suggestion" @onclick="() => SendAsync(suggestion)">@suggestion</button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @for (var index = 0; index < items.Count; index++)
                    {
                        var item = items[index];
                        var previous = index > 0 ? items[index - 1] : null;
                        var newDay = previous is null || LocalDate(previous) != LocalDate(item);
                        var grouped = !newDay && previous is not null && SameSender(previous, item)
                                      && item.TimestampUtc - previous.TimestampUtc < GroupWindow;
                        var mine = item.Kind == SurfaceTimelineItemKind.Principal;
                        var problem = item.Kind == SurfaceTimelineItemKind.Error;
                        if (newDay)
                        {
                            <div class="surface-chat-day" @key="@($"day-{item.Id}")"><span>@DayLabel(item)</span></div>
                        }
                        <article class="@MessageClass(item, grouped)" @key="item.Id" data-surface-chat-item>
                            @if (!mine)
                            {
                                <span class="surface-chat-avatar @(problem ? "is-error" : "is-agent") @(grouped ? "is-spacer" : string.Empty)" aria-hidden="true">
                                    @if (!grouped)
                                    {
                                        <i class="@(problem ? "bi bi-exclamation-triangle" : Icon)"></i>
                                    }
                                </span>
                            }
                            <div class="surface-chat-message-body">
                                @if (!grouped)
                                {
                                    <div class="surface-chat-meta">
                                        @if (!mine)
                                        {
                                            <span class="surface-chat-author">@AuthorOf(item)</span>
                                        }
                                        <time datetime="@item.TimestampUtc.ToString("o")">@Time(item)</time>
                                    </div>
                                }
                                @if (item.Kind == SurfaceTimelineItemKind.AdaptiveCard && item.Envelope is not null && SurfaceOptions.Value.EnableAdaptiveCards)
                                {
                                    <div class="surface-chat-bubble is-card">
                                        <SurfaceAdaptiveCardHost Envelope="item.Envelope"
                                                                 SourceMessage="item.SourceMessage"
                                                                 PrincipalContext="Workspace.PrincipalContext" />
                                    </div>
                                }
                                else if (mine)
                                {
                                    <div class="surface-chat-bubble">@item.Text</div>
                                }
                                else
                                {
                                    <div class="surface-chat-bubble">@Rendered(item)</div>
                                    @if (!problem && !string.IsNullOrWhiteSpace(item.Text))
                                    {
                                        <div class="surface-chat-tools">
                                            <button type="button"
                                                    class="surface-chat-tool"
                                                    title="@(_copied == item.Id ? "Copied" : "Copy")"
                                                    aria-label="Copy this message"
                                                    @onclick="() => CopyAsync(item)">
                                                <i class="bi @(_copied == item.Id ? "bi-check2" : "bi-copy")"></i>
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        </article>
                    }

                    @AfterMessages

                    @if (waiting)
                    {
                        <div class="surface-chat-message is-agent is-activity" data-surface-chat-item>
                            <span class="surface-chat-avatar is-agent" aria-hidden="true"><i class="@Icon"></i></span>
                            <div class="surface-chat-message-body">
                                <div class="surface-chat-typing">
                                    <span class="surface-chat-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                                    <span>@(progress ?? "Thinking…")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <button type="button" class="surface-chat-jump" @onclick="JumpToLatestAsync">
                <i class="bi bi-arrow-down"></i><span>Jump to latest</span>
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="surface-chat-error" role="alert"><i class="bi bi-exclamation-triangle"></i><span>@_error</span></div>
        }

        <SurfaceChatComposer @ref="_composer"
                             Conversation="@(TargetHandle ?? string.Empty)"
                             Drafts="@(Drafts ?? _drafts)"
                             Placeholder="@Placeholder"
                             CanSend="@(!waiting)"
                             Busy="@($"{DisplayTitle} is answering. You can keep typing, and send once it's done.")"
                             OnSend="SendAsync" />
    }
</section>

@code {
    private static readonly TimeSpan GroupWindow = TimeSpan.FromMinutes(5);

    /// <summary>The agent to chat with: its alias (made the principal's own) or a full handle, such as a shared <c>system:</c> agent.</summary>
    [Parameter, EditorRequired] public string AgentHandle { get; set; } = string.Empty;

    /// <summary>The agent's name in the header and on its messages.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public string Icon { get; set; } = "bi bi-robot";

    /// <summary>A line under the agent's name, such as what it's for.</summary>
    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? WelcomeTitle { get; set; }

    [Parameter] public string WelcomeMessage { get; set; } = "How can I help?";

    /// <summary>Questions shown on an empty chat; picking one sends it.</summary>
    [Parameter] public IReadOnlyList<string>? Suggestions { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Type a message";

    [Parameter] public string LoadingMessage { get; set; } = "Connecting…";

    /// <summary>
    /// The agent to create for the principal when it isn't there or isn't set up. Leave it out for an agent someone else makes, such as a
    /// shared one, which the chat only checks.
    /// </summary>
    [Parameter] public AgentConfiguration? Agent { get; set; }

    /// <summary>Changes each message before it goes, such as to send on a shared agent's channel, or with who's asking.</summary>
    [Parameter] public Action<AgentMessage>? ConfigureMessage { get; set; }

    [Parameter] public bool AllowNewConversation { get; set; } = true;

    /// <summary>Runs on New conversation instead of resetting the agent, such as for a shared agent that mustn't be reset.</summary>
    [Parameter] public Func<Task>? NewConversation { get; set; }

    /// <summary>The page's own words for a failure, in place of Surface's.</summary>
    [Parameter] public Func<Exception, SurfaceChatProblem>? DescribeProblem { get; set; }

    /// <summary>Unsent text per conversation, owned by the page so it outlives this chat (such as when moving between agents).</summary>
    [Parameter] public Dictionary<string, string>? Drafts { get; set; }

    [Parameter] public RenderFragment? HeaderActions { get; set; }

    /// <summary>Shown after the last message, such as cards asking the reader to confirm what the agent proposed.</summary>
    [Parameter] public RenderFragment? AfterMessages { get; set; }

    /// <summary>Shown with a failure, above Try again.</summary>
    [Parameter] public RenderFragment? ProblemActions { get; set; }

    /// <summary>Raised for each new message from the agent, once it's in the history.</summary>
    [Parameter] public EventCallback<AgentMessage> OnMessageReceived { get; set; }

    [Parameter] public EventCallback<string> OnMessageSent { get; set; }

    /// <summary>Raised each time the chat is connected and its agent ready, such as to ask a question for the reader.</summary>
    [Parameter] public EventCallback OnReady { get; set; }

    /// <summary>
    /// Who chats, in place of the signed-in principal (<see cref="ISurfacePrincipalContextProvider"/>), for an app that gives each of
    /// its chats its own principal. The page's workspace has one principal at a time, so show one such chat at a time.
    /// </summary>
    [Parameter] public FabrCore.Surface.Identity.SurfacePrincipalContext? Principal { get; set; }

    [Parameter] public string? CssClass { get; set; }

    private enum ChatState
    {
        Connecting,
        Ready,
        Problem
    }

    private readonly Dictionary<string, string> _drafts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, MarkupString> _rendered = new(StringComparer.Ordinal);
    private readonly HashSet<string> _processed = new(StringComparer.Ordinal);
    private FabrCore.Surface.Identity.SurfacePrincipalContext? _principal;
    private ChatState _state = ChatState.Connecting;
    private SurfaceChatProblem? _problem;
    private string? _error;
    private string? _startedFor;
    private bool _resetting;
    private bool _retrying;
    private string? _copied;
    private ElementReference _timelineRef;
    private SurfaceChatComposer? _composer;
    private IJSObjectReference? _module;
    private int? _offsetMinutes;
    private string? _renderedSignature;
    private bool _forceScroll;
    private bool _focus;

    /// <summary>True once the chat is connected and its agent is ready.</summary>
    public bool IsReady => _state == ChatState.Ready;

    private string? TargetHandle => NormalizeHandle(AgentHandle);

    private string DisplayTitle => Title ?? DisplayHandle(TargetHandle) ?? "Assistant";

    private IReadOnlyList<SurfaceTimelineItem> AllItems => TargetHandle is { Length: > 0 } handle
        ? Workspace.GetTimelineForAgent(handle).ToList()
        : [];

    private IReadOnlyList<SurfaceTimelineItem> VisibleItems => AllItems.Where(item => item.DisplayInChat).ToList();

    /// <summary>Waiting from the reader's last message until the agent answers, with what it says it's doing meanwhile.</summary>
    private (bool Waiting, string? Progress) Activity
    {
        get
        {
            var items = AllItems;
            var lastMine = -1;
            for (var index = items.Count - 1; index >= 0; index--)
            {
                if (items[index].Kind == SurfaceTimelineItemKind.Principal)
                {
                    lastMine = index;
                    break;
                }
            }

            if (lastMine < 0)
            {
                return (false, null);
            }

            string? progress = null;
            for (var index = lastMine + 1; index < items.Count; index++)
            {
                var item = items[index];
                if (item.Kind == SurfaceTimelineItemKind.Status)
                {
                    progress = string.IsNullOrWhiteSpace(item.Text) ? progress : item.Text.Trim();
                }
                else if (item.DisplayInChat)
                {
                    return (false, null);
                }
            }

            return (true, progress);
        }
    }

    private string PresenceClass => _state switch
    {
        ChatState.Ready when Activity.Waiting => "is-busy",
        ChatState.Ready => "is-ready",
        ChatState.Problem => "is-off",
        _ => "is-connecting"
    };

    private string PresenceText => _state switch
    {
        ChatState.Ready when Activity is { Waiting: true } activity => activity.Progress is null ? "Working…" : "Working",
        ChatState.Ready => "Available",
        ChatState.Problem => "Unavailable",
        _ => "Connecting…"
    };

    protected override void OnInitialized()
        => Workspace.Changed += OnWorkspaceChanged;

    protected override async Task OnParametersSetAsync()
    {
        var startFor = $"{Principal?.PrincipalId}|{AgentHandle}";
        if (string.Equals(_startedFor, startFor, StringComparison.Ordinal))
        {
            return;
        }

        _startedFor = startFor;
        _rendered.Clear();
        _error = null;
        await StartAsync();
        await RaiseReadyAsync();
    }

    private async Task RaiseReadyAsync()
    {
        if (_state == ChatState.Ready && OnReady.HasDelegate)
        {
            await OnReady.InvokeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/FabrCore.Surface/adaptiveCardsSurface.js");
                _offsetMinutes = await _module.InvokeAsync<int>("surfaceTimeZoneOffset");
                StateHasChanged();
            }
            catch (JSDisconnectedException)
            {
                return;
            }
        }

        if (_module is null || _state != ChatState.Ready)
        {
            return;
        }

        var signature = Signature();
        if (_forceScroll || !string.Equals(signature, _renderedSignature, StringComparison.Ordinal))
        {
            var force = _forceScroll;
            _forceScroll = false;
            _renderedSignature = signature;
            await _module.InvokeVoidAsync("bindSurfaceChatTimeline", _timelineRef);
            await _module.InvokeVoidAsync("scrollSurfaceChatToLatest", _timelineRef, force);
        }

        if (_focus && _composer is not null)
        {
            _focus = false;
            await _composer.FocusAsync();
        }
    }

    /// <summary>Sends a message as the reader, such as a question a page asks for them. Does nothing until the chat is ready.</summary>
    public async Task SendAsync(string text)
    {
        if (_state != ChatState.Ready || string.IsNullOrWhiteSpace(text) || TargetHandle is not { Length: > 0 } handle)
        {
            return;
        }

        _error = null;
        _forceScroll = true;
        try
        {
            await Workspace.SendChatAsync(text.Trim(), handle, fileIds: null, ConfigureMessage, CancellationToken.None);
            if (OnMessageSent.HasDelegate)
            {
                await OnMessageSent.InvokeAsync(text.Trim());
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SurfaceChat couldn't send to {Agent}.", handle);
            _error = ex is SurfaceConnectionException ? ex.Message : $"That didn't send: {ex.Message}";
        }

        StateHasChanged();
    }

    /// <summary>Connects again and checks the agent, after a failure.</summary>
    public async Task RetryAsync()
    {
        _retrying = true;
        try
        {
            await StartAsync();
        }
        finally
        {
            _retrying = false;
        }

        await RaiseReadyAsync();
    }

    public async Task FocusAsync()
    {
        if (_composer is not null)
        {
            await _composer.FocusAsync();
        }
    }

    private async Task StartAsync()
    {
        _state = ChatState.Connecting;
        _problem = null;
        try
        {
            _principal = Principal ?? await PrincipalContextProvider.GetCurrentAsync();
            if (!_principal.IsResolved)
            {
                ShowProblem(new SurfaceChatProblem("Sign in to chat", "The chat needs to know who you are before it can connect you to the agent."));
                return;
            }

            await Workspace.InitializeAsync(_principal);
            if (Workspace.PrincipalContext is not { } context)
            {
                throw new SurfaceConnectionException(SurfaceConnectionProblem.NotConfigured, "This app has no connection to a FabrCore host.");
            }

            await EnsureAgentAsync(context);
            foreach (var item in AllItems.Where(IsIncoming))
            {
                _processed.Add(item.Id);
            }

            Workspace.MarkAgentSeen(TargetHandle);
            _state = ChatState.Ready;
            _forceScroll = true;
            _focus = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SurfaceChat couldn't start with {Agent}.", AgentHandle);
            ShowProblem(DescribeProblem?.Invoke(ex) ?? SurfaceChatProblem.From(ex, DisplayTitle));
        }
    }

    /// <summary>Creates the principal's agent when it isn't set up. An agent the chat doesn't create must already be set up.</summary>
    private async Task EnsureAgentAsync(ISurfacePrincipalContext context)
    {
        var handle = TargetHandle!;
        var health = await context.GetAgentHealth(handle);
        if (health.IsConfigured)
        {
            return;
        }

        if (Agent is null)
        {
            throw new SurfaceConnectionException(SurfaceConnectionProblem.AgentMissing,
                $"{DisplayTitle} isn't set up on the FabrCore host yet.{Detail(health)}");
        }

        Agent.Handle ??= DisplayHandle(handle);
        health = await context.CreateAgent(Agent);
        if (!health.IsConfigured)
        {
            throw new SurfaceConnectionException(SurfaceConnectionProblem.AgentMissing,
                $"{DisplayTitle} couldn't be set up on the FabrCore host.{Detail(health)}");
        }
    }

    private static string Detail(AgentHealthStatus health)
        => string.IsNullOrWhiteSpace(health.Message) ? string.Empty : $" The host said: {health.Message}";

    private void ShowProblem(SurfaceChatProblem problem)
    {
        _problem = problem;
        _state = ChatState.Problem;
    }

    private async Task NewConversationAsync()
    {
        if (TargetHandle is not { Length: > 0 } handle)
        {
            return;
        }

        _resetting = true;
        _error = null;
        try
        {
            if (NewConversation is not null)
            {
                await NewConversation();
            }
            else if (Workspace.PrincipalContext is { } context)
            {
                await context.ResetAgent(handle);
            }
        }
        catch (Exception ex)
        {
            // The agent may be what's wrong: the history is cleared anyway, and the next message checks the agent again.
            Logger.LogWarning(ex, "SurfaceChat couldn't reset {Agent}.", handle);
            _error = "The agent couldn't be reset just now, so it may still remember this conversation.";
        }
        finally
        {
            _resetting = false;
        }

        Workspace.ClearTimeline(handle);
        _rendered.Clear();
        _focus = true;
    }

    private async Task JumpToLatestAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollSurfaceChatToLatest", _timelineRef, true);
        }
    }

    private async Task CopyAsync(SurfaceTimelineItem item)
    {
        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync("copyTextToClipboard", item.Text ?? string.Empty);
        _copied = item.Id;
        StateHasChanged();
        await Task.Delay(1500);
        if (_copied == item.Id)
        {
            _copied = null;
            StateHasChanged();
        }
    }

    private void OnWorkspaceChanged()
        => _ = InvokeAsync(OnWorkspaceChangedAsync);

    private async Task OnWorkspaceChangedAsync()
    {
        if (_state == ChatState.Ready)
        {
            var incoming = AllItems.Where(item => IsIncoming(item) && _processed.Add(item.Id)).ToList();
            if (incoming.Count > 0)
            {
                Workspace.MarkAgentSeen(TargetHandle);
            }

            if (OnMessageReceived.HasDelegate)
            {
                foreach (var item in incoming.Where(item => item.DisplayInChat && item.SourceMessage is not null))
                {
                    try
                    {
                        await OnMessageReceived.InvokeAsync(item.SourceMessage!);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "SurfaceChat's OnMessageReceived failed for {Agent}.", AgentHandle);
                    }
                }
            }
        }

        StateHasChanged();
    }

    private static bool IsIncoming(SurfaceTimelineItem item)
        => item.Kind != SurfaceTimelineItemKind.Principal;

    private string Signature()
    {
        var items = AllItems;
        var (waiting, progress) = Activity;
        return $"{items.Count}|{items.LastOrDefault()?.Id}|{waiting}|{progress}";
    }

    private MarkupString Rendered(SurfaceTimelineItem item)
    {
        if (!_rendered.TryGetValue(item.Id, out var html))
        {
            html = new MarkupString(SurfaceMarkdownRenderer.Render(item.Text));
            _rendered[item.Id] = html;
        }

        return html;
    }

    private static string MessageClass(SurfaceTimelineItem item, bool grouped)
        => "surface-chat-message " + (item.Kind switch
        {
            SurfaceTimelineItemKind.Principal => "is-mine",
            SurfaceTimelineItemKind.Error => "is-agent is-error",
            SurfaceTimelineItemKind.AdaptiveCard => "is-agent is-card",
            _ => "is-agent"
        }) + (grouped ? " is-grouped" : string.Empty);

    private static bool SameSender(SurfaceTimelineItem previous, SurfaceTimelineItem item)
        => (previous.Kind == SurfaceTimelineItemKind.Principal) == (item.Kind == SurfaceTimelineItemKind.Principal)
           && previous.Kind != SurfaceTimelineItemKind.Error
           && item.Kind != SurfaceTimelineItemKind.Error;

    private string AuthorOf(SurfaceTimelineItem item)
        => item.Kind == SurfaceTimelineItemKind.Principal
            ? _principal?.DisplayName ?? "You"
            : Title ?? DisplayHandle(item.SourceMessage?.FromHandle ?? item.Author) ?? "Agent";

    private DateTime Local(DateTime utc)
    {
        var value = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        return _offsetMinutes is { } offset
            ? DateTime.SpecifyKind(value.AddMinutes(offset), DateTimeKind.Unspecified)
            : value.ToLocalTime();
    }

    private DateOnly LocalDate(SurfaceTimelineItem item)
        => DateOnly.FromDateTime(Local(item.TimestampUtc));

    private string Time(SurfaceTimelineItem item)
        => Local(item.TimestampUtc).ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture);

    private string DayLabel(SurfaceTimelineItem item)
    {
        var day = LocalDate(item);
        var today = DateOnly.FromDateTime(Local(DateTime.UtcNow));
        if (day == today)
        {
            return "Today";
        }

        if (day == today.AddDays(-1))
        {
            return "Yesterday";
        }

        var culture = System.Globalization.CultureInfo.InvariantCulture;
        return day.Year == today.Year ? day.ToString("dddd, MMMM d", culture) : day.ToString("MMMM d, yyyy", culture);
    }

    private string? NormalizeHandle(string? handle)
    {
        if (string.IsNullOrWhiteSpace(handle))
        {
            return null;
        }

        var trimmed = handle.Trim();
        if (trimmed.Contains(':', StringComparison.Ordinal) || _principal?.PrincipalId is not { Length: > 0 } principalId)
        {
            return trimmed;
        }

        return HandleUtilities.EnsurePrefix(trimmed, $"{principalId}:");
    }

    private static string? DisplayHandle(string? handle)
    {
        if (string.IsNullOrWhiteSpace(handle))
        {
            return null;
        }

        var colon = handle.IndexOf(':', StringComparison.Ordinal);
        return colon >= 0 && colon + 1 < handle.Length ? handle[(colon + 1)..] : handle;
    }

    public async ValueTask DisposeAsync()
    {
        Workspace.Changed -= OnWorkspaceChanged;
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
