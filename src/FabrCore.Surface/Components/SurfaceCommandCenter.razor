            _appliedSquadQueryHandle = SquadQueryHandle;
            _appliedAgentQueryHandle = null;
            SelectSquad(SquadQueryHandle);
            return;
        }

        if (!string.IsNullOrWhiteSpace(AgentQueryHandle)
            && !string.Equals(AgentQueryHandle, _appliedAgentQueryHandle, StringComparison.OrdinalIgnoreCase))
        {
            _appliedAgentQueryHandle = AgentQueryHandle;
            _appliedSquadQueryHandle = null;
            SelectAgent(AgentQueryHandle);
        }
    }

