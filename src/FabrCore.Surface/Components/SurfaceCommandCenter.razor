    private string MessageAuthor(SurfaceTimelineItem item)
        => item.Kind == SurfaceTimelineItemKind.Principal
            ? _principalContext?.DisplayName ?? _principalContext?.PrincipalId ?? "Principal"
            : DisplayHandle(GetMessageFrom(item.SourceMessage) ?? item.Author ?? "Agent");

    private string MessageRoute(SurfaceTimelineItem item)
    {
        var message = item.SourceMessage;
        if (message is null)
        {
            if (item.Kind == SurfaceTimelineItemKind.Principal && !string.IsNullOrWhiteSpace(item.AgentHandle))
            {
                return $"to {DisplayHandle(item.AgentHandle)}";
            }

            return string.Empty;
        }

        var from = DisplayHandle(GetMessageFrom(message));
        var to = DisplayHandle(GetMessageTo(message));
        if (string.IsNullOrWhiteSpace(from) || string.IsNullOrWhiteSpace(to))
        {
            return string.Empty;
        }

        if (item.Kind == SurfaceTimelineItemKind.Principal)
        {
            return $"to {to}";
        }

        return $"{from} -> {to}";
    }

    private string MessageInitials(SurfaceTimelineItem item)
        => item.Kind == SurfaceTimelineItemKind.Principal
            ? Initials(_principalContext?.DisplayName ?? _principalContext?.PrincipalId ?? "Principal")
            : Initials(DisplayHandle(GetMessageFrom(item.SourceMessage) ?? item.Author ?? "Agent"));

    private static MarkupString RenderMarkdown(string? text)
        => new(SurfaceMarkdownRenderer.Render(text));

    private static bool IsSquadMirror(SurfaceTimelineItem item)
        => item.SourceMessage?.Args is not null
           && item.SourceMessage.Args.TryGetValue(SurfaceSquadArgs.Mirror, out var mirror)
           && string.Equals(mirror, "true", StringComparison.OrdinalIgnoreCase);

    private static bool IsAgentToAgent(SurfaceTimelineItem item)
    {
        var message = item.SourceMessage;
        var from = GetMessageFrom(message);
        var to = GetMessageTo(message);
        return from?.Contains(':', StringComparison.Ordinal) == true
               && to?.Contains(':', StringComparison.Ordinal) == true
               && message?.Args?.ContainsKey(SurfaceSquadArgs.SquadHandle) == true
               && !string.Equals(from, to, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsAgentToUser(SurfaceTimelineItem item)
    {
        var message = item.SourceMessage;
        var from = GetMessageFrom(message);
        var to = GetMessageTo(message);
        return from?.Contains(':', StringComparison.Ordinal) == true
               && !string.IsNullOrWhiteSpace(to)
               && (string.Equals(to, _principalContext?.PrincipalId, StringComparison.OrdinalIgnoreCase)
                   || !to.Contains(':', StringComparison.Ordinal));
    }

    private static string? GetMessageFrom(AgentMessage? message)
        => message is null
            ? null
            : GetMessageArg(message, SurfaceSquadArgs.OriginalFromHandle) ?? message.FromHandle;

    private static string? GetMessageTo(AgentMessage? message)
        => message is null
            ? null
            : GetMessageArg(message, SurfaceSquadArgs.OriginalToHandle) ?? message.ToHandle;

    private static string DisplayHandle(string? handle)
    {
        if (string.IsNullOrWhiteSpace(handle))
        {
            return string.Empty;
        }

        var colon = handle.IndexOf(':', StringComparison.Ordinal);
        return colon >= 0 && colon + 1 < handle.Length ? handle[(colon + 1)..] : handle;
    }

    private static string? GetMessageArg(AgentMessage message, string key)
        => message.Args is not null && message.Args.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
            ? value
            : null;

    private static string Initials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "A";
        }

        var parts = value.Split([' ', '-', '_', ':'], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        }

        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private static string FormatDateSeparator(DateTime localTimestamp)
    {
        var today = DateTime.Today;
        if (localTimestamp.Date == today)
        {
            return "Today";
        }

        if (localTimestamp.Date == today.AddDays(-1))
        {
            return "Yesterday";
        }

        return localTimestamp.ToString("dddd");
    }

    private static string FormatMessageTimestamp(DateTime localTimestamp)
        => localTimestamp.ToString("dddd h:mm tt");

    private static string FormatLatency(double? milliseconds)
        => milliseconds.HasValue ? $"{milliseconds.Value:N0} ms" : "-";

    private void OnWorkspaceChanged()
    {
        if (Workspace.SelectedSquad is null)
        {
            _selectedSquadTab = SurfaceSquadTab.Chat;
        }

        var selectedHandle = Workspace.SelectedAgent?.Handle;
        var selectedChanged = !string.Equals(selectedHandle, _lastTimelineAgentHandle, StringComparison.OrdinalIgnoreCase);
        var visibleTimelineCount = CountSelectedTimeline();
        var activityText = SelectedActivityText();
        var activityChanged = !string.Equals(activityText, _lastActivityText, StringComparison.Ordinal);
        if (selectedChanged || visibleTimelineCount > _visibleTimelineCount || (activityChanged && !string.IsNullOrWhiteSpace(activityText)))
        {
            _timelineScrollRequested = true;
        }

        _lastTimelineAgentHandle = selectedHandle;
        _visibleTimelineCount = visibleTimelineCount;
        _lastActivityText = activityText;
        _ = InvokeAsync(StateHasChanged);
    }

    private int CountSelectedTimeline()
    {
        if (Workspace.SelectedAgent is null)
        {
            return 0;
        }

        return SelectedTimeline().Count();
    }

