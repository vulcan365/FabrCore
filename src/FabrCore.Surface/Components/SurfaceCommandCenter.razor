    private async Task HandleFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        foreach (var file in args.GetMultipleFiles())
        {
            var attachment = new SurfacePendingAttachment(file.Name, file.Size, file.ContentType);
            _pendingAttachments.Add(attachment);
            await InvokeAsync(StateHasChanged);

            try
            {
                await using var stream = file.OpenReadStream(SurfaceOptions.Value.MaxChatAttachmentBytes);
                var uploaded = await FileUploadClient.UploadAsync(
                    stream,
                    file.Name,
                    file.ContentType,
                    SurfaceOptions.Value.ChatFileUploadTtl,
                    _timerCts?.Token ?? CancellationToken.None);
                attachment.FileId = uploaded.FileId;
                if (attachment.DeleteWhenUploaded)
                {
                    await DeleteUploadedAttachmentAsync(attachment);
                }
            }
            catch (Exception ex)
            {
                if (!attachment.DeleteWhenUploaded)
                {
                    attachment.Error = ex.Message;
                }
            }
            finally
            {
                attachment.IsUploading = false;
                if (!attachment.DeleteWhenUploaded)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private async Task RemoveAttachmentAsync(string id)
    {
        var attachment = _pendingAttachments.FirstOrDefault(attachment => string.Equals(attachment.Id, id, StringComparison.Ordinal));
        if (attachment is null)
        {
            return;
        }

        _pendingAttachments.Remove(attachment);
        attachment.DeleteWhenUploaded = true;

        if (!string.IsNullOrWhiteSpace(attachment.FileId))
        {
            await DeleteUploadedAttachmentAsync(attachment);
        }
    }

    private async Task DeleteUploadedAttachmentAsync(SurfacePendingAttachment attachment)
    {
        try
        {
            await FileUploadClient.DeleteAsync(attachment.FileId!);
        }
        catch
        {
            // The pending attachment is no longer part of a message; TTL cleanup remains the fallback.
        }
    }

    private List<string> ReadyAttachmentFileIds()
        => _pendingAttachments
            .Where(attachment => attachment.IsReady && !string.IsNullOrWhiteSpace(attachment.FileId))
            .Select(attachment => attachment.FileId!)
            .ToList();

    private void UpdateMentionPicker()
    {
        if (TryGetMentionQuery(out var query))
        {
            _mentionActive = true;
            _mentionQuery = query;
            var count = MentionCandidates().Count;
            _mentionSelectedIndex = count == 0 ? 0 : Math.Clamp(_mentionSelectedIndex, 0, count - 1);
            return;
        }

        CloseMentionPicker();
    }

    private bool TryGetMentionQuery(out string query)
    {
        query = string.Empty;
        if (Workspace.SelectedSquad is null || !_draft.StartsWith('@'))
        {
            return false;
        }

        var splitAt = _draft.IndexOfAny([' ', '\t', '\r', '\n']);
        if (splitAt >= 0)
        {
            return false;
        }

        query = _draft.Length > 1 ? _draft[1..] : string.Empty;
        return true;
    }

    private IReadOnlyList<SurfaceMentionCandidate> MentionCandidates()
    {
        var squad = Workspace.SelectedSquad;
        if (squad is null)
        {
            return [];
        }

        var query = _mentionQuery.Trim();
        var candidates = new List<SurfaceMentionCandidate>();

        if (squad.SquadType != SurfaceSquadType.Task)
        {
            candidates.AddRange(squad.Agents.Select(agent =>
            {
                var displayName = string.IsNullOrWhiteSpace(agent.Name) ? DisplayHandle(agent.Handle) : agent.Name;
                var mention = string.IsNullOrWhiteSpace(agent.Name) || agent.Name.Any(char.IsWhiteSpace)
                    ? DisplayHandle(agent.Handle)
                    : agent.Name;
                var detail = string.IsNullOrWhiteSpace(agent.Description)
                    ? agent.AgentType
                    : agent.Description!;
                return new SurfaceMentionCandidate(mention, displayName, detail, agent.Handle, 0);
            }));
        }

        candidates.Add(new("orchestrator", "Orchestrator", "Squad orchestrator", squad.OrchestratorHandle, 1));

        return candidates
            .Where(candidate => string.IsNullOrWhiteSpace(query)
                                || candidate.Mention.Contains(query, StringComparison.OrdinalIgnoreCase)
                                || candidate.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase)
                                || candidate.Detail.Contains(query, StringComparison.OrdinalIgnoreCase)
                                || candidate.Handle.Contains(query, StringComparison.OrdinalIgnoreCase))
            .OrderBy(candidate => candidate.SortRank)
            .ThenBy(candidate => candidate.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

