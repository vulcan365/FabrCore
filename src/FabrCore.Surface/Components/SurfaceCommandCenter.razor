    private void ApplyTargetQuery()
    {
        if (!string.IsNullOrWhiteSpace(SquadQueryHandle)
            && !string.Equals(SquadQueryHandle, _appliedSquadQueryHandle, StringComparison.OrdinalIgnoreCase))
