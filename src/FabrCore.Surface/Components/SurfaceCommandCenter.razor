@page "/surface"
@rendermode InteractiveServer
@inject ISurfacePrincipalContextProvider PrincipalContextProvider
@inject SurfaceWorkspaceService Workspace
@inject ISurfaceFileUploadClient FileUploadClient
@inject Microsoft.Extensions.Options.IOptions<SurfaceOptions> SurfaceOptions
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>FabrCore Surface</PageTitle>

<div class="@CommandCenterClass">
    @if (_loading)
    {
        <main class="surface-command-empty">
            <h1>FabrCore Surface</h1>
            <p>Loading your agent command center...</p>
        </main>
    }
    else if (_principalContext?.IsResolved != true)
    {
        <main class="surface-command-empty">
            <h1>FabrCore Surface</h1>
            <p>Surface needs an authenticated principal id before it can connect to your agents.</p>
        </main>
    }
    else
    {
        <header class="surface-topbar">
            <SurfaceTopbarNav />
            <div class="surface-topbar-user">
                <span class="surface-agent-avatar-wrap">
                    <span class="surface-agent-avatar">@Initials(_principalContext.DisplayName ?? _principalContext.PrincipalId)</span>
                    <span class="surface-avatar-status is-healthy"></span>
                </span>
            </div>
        </header>

        <SurfaceCommandRail />

        <aside class="surface-agent-list" aria-label="Agents">
            <header class="surface-panel-header">
                <div>
                    <h1>Chat</h1>
                    <span class="surface-panel-eyebrow">@(_principalContext.DisplayName ?? _principalContext.PrincipalId)</span>
                </div>
                <div class="surface-panel-actions">
                    <button class="surface-icon-button" @onclick="RefreshAgentsAsync" title="Refresh agents" aria-label="Refresh agents">⌕</button>
                    <button class="surface-icon-button"
                            title="More options"
                            aria-label="More options"
                            @onclick="TogglePanelMenu">…</button>
                    @if (_panelMenuOpen)
                    {
                        <div class="surface-panel-menu">
                            <button type="button" class="surface-panel-menu-item" @onclick="OpenSettings">Settings</button>
                        </div>
                    }
                </div>
            </header>

            @if (Workspace.Squads.Count > 0)
            {
                <div class="@SectionTitleClass(Workspace.SelectedSquad is not null)">Squads</div>
                <nav class="surface-agent-nav">
                    @foreach (var squad in Workspace.Squads)
                    {
                        <button class="surface-agent-row @(IsSelectedSquad(squad) ? "is-selected" : "")"
                                @onclick="() => SelectSquad(squad.OrchestratorHandle)">
                            <span class="surface-agent-avatar-wrap">
                                <span class="surface-agent-avatar">#</span>
                                <span class="surface-avatar-status is-healthy"></span>
                            </span>
                            <span class="surface-agent-copy">
                                <span class="surface-agent-name">@squad.Name</span>
                                <span class="surface-agent-meta">@($"{squad.SquadType} - {squad.Agents.Count} agents")</span>
                            </span>
                        </button>
                    }
                </nav>
            }

            <div class="@SectionTitleClass(Workspace.SelectedSquad is null && Workspace.SelectedAgent is not null)">Agents</div>

            @if (!SurfaceOptions.Value.EnableAgentDirectory)
            {
                <div class="surface-command-note">Agent directory is disabled.</div>
            }
            else if (Workspace.Agents.Count == 0)
            {
                <div class="surface-command-note">No agents are available for this principal yet.</div>
            }
            else
            {
                <nav class="surface-agent-nav">
                    @foreach (var agent in Workspace.Agents)
                    {
                        <button class="@AgentRowClass(agent)"
                                @onclick="() => SelectAgent(agent.Handle)">
                            <span class="surface-agent-avatar-wrap">
                                <span class="surface-agent-avatar">@Initials(agent.DisplayName)</span>
                                <span class="surface-avatar-status @PresenceClass(agent)" title="@PresenceText(agent)"></span>
                            </span>
                            <span class="surface-agent-copy">
                                <span class="surface-agent-name">@agent.DisplayName</span>
                                <span class="surface-agent-meta">@AgentMeta(agent)</span>
                            </span>
                            @if (agent.HasUnread)
                            {
                                <span class="surface-unread-badge" aria-label="@($"{agent.UnreadCount} unread messages")">@agent.UnreadCount</span>
                            }
                        </button>
                    }
                </nav>
            }

        </aside>

        <main class="surface-agent-workspace">
            @if (Workspace.SelectedAgent is null)
            {
                <section class="surface-command-empty">
                    <h2>Select an agent</h2>
                    <p>Choose an agent to inspect activity and send commands.</p>
                </section>
            }
            else
            {
                <header class="surface-chat-header">
                    <div class="surface-chat-title">
                        <span class="surface-agent-avatar-wrap">
                            <span class="surface-agent-avatar is-large">@Initials(Workspace.SelectedAgent.DisplayName)</span>
                            <span class="surface-avatar-status @PresenceClass(Workspace.SelectedAgent)" title="@PresenceText(Workspace.SelectedAgent)"></span>
                        </span>
                        <div>
                            <h2>@Workspace.SelectedAgent.DisplayName</h2>
                            <p>@AgentSubtitle(Workspace.SelectedAgent)</p>
                        </div>
                    </div>
                    <div class="surface-chat-tabs">
                        <span class="is-active">Chat</span>
                    </div>
                </header>

                @if (IsSquadSettingsTab)
                {
                    @SquadSettingsContent()
                }
                else
                {
                    <section class="surface-timeline" @ref="_timelineRef" aria-live="polite">
                        @{
                            DateOnly? previousDate = null;
                        }
                        @foreach (var item in SelectedTimeline())
                        {
                            var localTimestamp = item.TimestampUtc.ToLocalTime();
                            var itemDate = DateOnly.FromDateTime(localTimestamp);
                            var isAgentToAgent = IsAgentToAgent(item);
                            var isAgentToAgentExpanded = isAgentToAgent && IsAgentToAgentExpanded(item);
                            var messageClass = MessageClass(item);
                            if (isAgentToAgent)
                            {
                                messageClass += isAgentToAgentExpanded ? " is-expanded" : " is-collapsed";
                            }

                            if (previousDate != itemDate)
                            {
                                <div class="surface-date-separator">@FormatDateSeparator(localTimestamp)</div>
                                previousDate = itemDate;
                            }

                            <article class="surface-message @messageClass" data-surface-timeline-item>
                                @if (item.Kind != SurfaceTimelineItemKind.Principal)
                                {
                                    <span class="surface-message-avatar-wrap">
                                        <span class="surface-message-avatar">@MessageInitials(item)</span>
                                        <span class="surface-avatar-status @SelectedPresenceClass()" title="@SelectedPresenceText()"></span>
                                    </span>
                                }
                                <div class="surface-message-body">
                                    <div class="surface-message-meta">
                                        <span>@MessageAuthor(item)</span>
                                        @if (MessageRoute(item) is { Length: > 0 } route)
                                        {
                                            <span class="surface-message-route">@route</span>
                                        }
                                        <time>@FormatMessageTimestamp(localTimestamp)</time>
                                    </div>

                                    @if (isAgentToAgent)
                                    {
                                        <div class="surface-agent-to-agent">
                                            <button type="button"
                                                    class="surface-agent-message-toggle"
                                                    title="@AgentToAgentToggleTitle(isAgentToAgentExpanded)"
                                                    aria-label="@AgentToAgentToggleTitle(isAgentToAgentExpanded)"
                                                    aria-expanded="@isAgentToAgentExpanded"
                                                    @onclick="() => ToggleAgentToAgentMessage(item.Id)">
                                                <i class="bi @(isAgentToAgentExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                            </button>
                                            <div class="surface-agent-to-agent-content">
                                                <div class="surface-agent-to-agent-preview">@AgentToAgentPreview(item)</div>
                                                @if (isAgentToAgentExpanded)
                                                {
                                                    @if (item.Kind == SurfaceTimelineItemKind.AdaptiveCard && item.Envelope is not null && SurfaceOptions.Value.EnableAdaptiveCards)
                                                    {
                                                        <SurfaceAdaptiveCardHost Envelope="item.Envelope"
                                                                                 SourceMessage="item.SourceMessage"
                                                                                 PrincipalContext="Workspace.PrincipalContext" />
                                                    }
                                                    else
                                                    {
                                                        <div class="surface-message-markdown">@RenderMarkdown(item.Text)</div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                    else if (item.Kind == SurfaceTimelineItemKind.AdaptiveCard && item.Envelope is not null && SurfaceOptions.Value.EnableAdaptiveCards)
                                    {
                                        <SurfaceAdaptiveCardHost Envelope="item.Envelope"
                                                                 SourceMessage="item.SourceMessage"
                                                                 PrincipalContext="Workspace.PrincipalContext" />
                                    }
                                    else
                                    {
                                        <div class="surface-message-markdown">@RenderMarkdown(item.Text)</div>
                                    }

                                    @if (item.Kind != SurfaceTimelineItemKind.Principal)
                                    {
                                        <div class="surface-message-actions">
                                            <button type="button"
                                                    class="surface-message-action"
                                                    title="Copy full message"
                                                    aria-label="Copy full message"
                                                    @onclick="() => CopyMessageAsync(item)">
                                                <i class="bi @(IsCopiedMessage(item) ? "bi-check2" : "bi-copy")"></i>
                                            </button>
                                            @if (MessageTokenUsageText(item) is { Length: > 0 } tokenUsageText)
                                            {
                                                <span class="surface-message-token-usage"
                                                      title="Actual LLM token usage from AgentMessage.Args.">
                                                    @tokenUsageText
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }

                        @{
                            var selectedActivityText = SelectedActivityText();
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedActivityText))
                        {
                            <div class="surface-system-activity" data-surface-timeline-activity>
                                <span class="surface-system-pulse"></span>
                                <span>@selectedActivityText</span>
                            </div>
                        }
                    </section>

                    <footer class="surface-compose">
                        <div class="surface-compose-field">
                            @if (MentionPickerOpen)
                            {
                                <div class="surface-mention-menu" role="listbox" aria-label="Mention an agent">
                                    @foreach (var candidate in MentionCandidates().Select((candidate, index) => (candidate, index)))
                                    {
                                        <button type="button"
                                                class="surface-mention-option @(candidate.index == _mentionSelectedIndex ? "is-active" : "")"
                                                role="option"
                                                aria-selected="@(candidate.index == _mentionSelectedIndex)"
                                                @onclick="() => SelectMention(candidate.candidate)">
                                            <span class="surface-mention-avatar">@Initials(candidate.candidate.DisplayName)</span>
                                            <span>
                                                <strong>@candidate.candidate.DisplayName</strong>
                                                <small>@candidate.candidate.Detail</small>
                                            </span>
                                            <code>@($"@{candidate.candidate.Mention}")</code>
                                        </button>
                                    }
                                </div>
                            }
                            <textarea @ref="_composerRef"
                                      value="@_draft"
                                      @oninput="HandleComposerInput"
                                      data-surface-mention-open="@MentionPickerOpen.ToString().ToLowerInvariant()"
                                      placeholder="Send a command to this agent..."
                                      disabled="@(!SurfaceOptions.Value.EnableAgentChat)"
                                      rows="2"></textarea>
                            @if (_pendingAttachments.Count > 0)
                            {
                                <div class="surface-attachment-list" aria-label="Attached files">
                                    @foreach (var attachment in _pendingAttachments)
                                    {
                                        <span class="surface-attachment-chip @(attachment.Error is null ? string.Empty : "is-error")" @key="attachment.Id">
                                            <i class="bi bi-paperclip"></i>
                                            <span>@attachment.Name</span>
                                            @if (attachment.IsUploading)
                                            {
                                                <small>Uploading</small>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(attachment.Error))
                                            {
                                                <small>@attachment.Error</small>
                                            }
                                            <button type="button"
                                                    title="Remove file"
                                                    aria-label="@($"Remove {attachment.Name}")"
                                                    @onclick="() => RemoveAttachmentAsync(attachment.Id)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                        <label class="surface-file-button"
                               title="Add files"
                               aria-label="Add files">
                            <i class="bi bi-paperclip"></i>
                            <InputFile class="surface-file-input"
                                       OnChange="HandleFilesSelectedAsync"
                                       multiple
                                       disabled="@(!CanAttachFiles)" />
                        </label>
                        <button @onclick="SendAsync"
                                disabled="@(!CanSend)"
                                title="Send command"
                                aria-label="Send command">Send</button>
                    </footer>
                }
            }
        </main>

        <aside class="surface-activity-panel" aria-label="Agent activity">
            <header class="surface-panel-header">
                <div>
                    <span class="surface-panel-eyebrow">Activity</span>
                    <h2>Live state</h2>
                </div>
            </header>

            @if (Workspace.SelectedAgent is not null)
            {
                <dl class="surface-facts">
                    <div>
                        <dt>Handle</dt>
                        <dd>@Workspace.SelectedAgent.Handle</dd>
                    </div>
                    <div>
                        <dt>Health</dt>
                        <dd>@Workspace.SelectedAgent.State</dd>
                    </div>
                    <div>
                        <dt>Messages</dt>
                        <dd>@(Workspace.SelectedAgent.Health?.MessagesProcessed?.ToString("N0") ?? "0")</dd>
                    </div>
                    <div>
                        <dt>Latency p95</dt>
                        <dd>@FormatLatency(Workspace.SelectedAgent.Health?.LatencyP95Ms)</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Workspace.SelectedAgent.StatusText))
                {
                    <div class="surface-status-note">@Workspace.SelectedAgent.StatusText</div>
                }
            }

            @if (SurfaceOptions.Value.EnableDiagnosticsPanel)
            {
                <div class="surface-command-note">Diagnostics are enabled for this Surface instance.</div>
            }
        </aside>

        @if (_settingsOpen)
        {
            <div class="surface-create-modal" role="dialog" aria-modal="true" aria-labelledby="surface-settings-title">
                <div class="surface-create-backdrop" @onclick="CloseSettings"></div>
                <section class="surface-create-panel surface-settings-panel">
                    <header class="surface-create-header">
                        <div>
                            <span class="surface-panel-eyebrow">Command center</span>
                            <h2 id="surface-settings-title">Settings</h2>
                        </div>
                        <button type="button" class="surface-card-modal-close" @onclick="CloseSettings">Close</button>
                    </header>

                    <div class="surface-create-body">
                        <section class="surface-create-section">
                            <h3>Agent list</h3>
                            <label class="surface-check-row">
                                <input type="checkbox"
                                       checked="@Workspace.ShowHiddenAgents"
                                       @onchange="OnShowHiddenAgentsChanged" />
                                <span>Show hidden agents</span>
                            </label>
                            <label class="surface-check-row">
                                <input type="checkbox"
                                       checked="@Workspace.ShowRunningAgents"
                                       @onchange="OnShowRunningAgentsChanged" />
                                <span>Show running agents</span>
                            </label>
                        </section>
                    </div>
                </section>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public SurfaceCommandCenterLayoutMode? LayoutMode { get; set; }

    [SupplyParameterFromQuery(Name = "agent")]
    public string? AgentQueryHandle { get; set; }

    [SupplyParameterFromQuery(Name = "squad")]
    public string? SquadQueryHandle { get; set; }

    private FabrCore.Surface.Identity.SurfacePrincipalContext? _principalContext;
    private PeriodicTimer? _agentTimer;
    private PeriodicTimer? _healthTimer;
    private CancellationTokenSource? _timerCts;
    private IDisposable? _activeView;
    private IJSObjectReference? _composerModule;
    private DotNetObjectReference<SurfaceCommandCenter>? _dotNetRef;
    private ElementReference _composerRef;
    private ElementReference _timelineRef;
    private string _draft = string.Empty;
    private bool _loading = true;
    private bool _sending;
    private bool _composerFocusRequested;
    private bool _timelineScrollRequested;
    private int _visibleTimelineCount;
    private string? _lastTimelineAgentHandle;
    private string? _lastActivityText;
    private string? _appliedAgentQueryHandle;
    private string? _appliedSquadQueryHandle;
    private readonly HashSet<string> _expandedAgentToAgentMessageIds = new(StringComparer.Ordinal);
    private readonly List<SurfacePendingAttachment> _pendingAttachments = [];
    private string? _copiedMessageId;
    private SurfaceAgentConfigurationDraft _createDraft = new();
    private SurfaceSquadDraft _squadDraft = new();
    private bool _createBusy;
    private string? _createError;
    private bool _squadCreateBusy;
    private string? _squadCreateError;
    private bool _panelMenuOpen;
    private bool _settingsOpen;
    private SurfaceSquadTab _selectedSquadTab = SurfaceSquadTab.Chat;
    private string? _squadAgentMode;
    private bool _squadAgentBusy;
    private string? _squadAgentError;
    private string? _squadSettingsError;
    private string? _removingSquadAgentHandle;
    private string _existingAgentHandle = string.Empty;
    private string _existingAgentName = string.Empty;
    private SurfaceSquadMemberRole _existingAgentRole = SurfaceSquadMemberRole.Executor;
    private SurfaceSquadAgentDraft _squadAgentDraft = new();
    private bool _mentionActive;
    private string _mentionQuery = string.Empty;
    private int _mentionSelectedIndex;

    private bool CanSend
        => SurfaceOptions.Value.EnableAgentChat
           && !_sending
           && Workspace.SelectedAgent is not null
           && !HasUploadingAttachments
           && !HasFailedAttachments
           && (!string.IsNullOrWhiteSpace(_draft) || ReadyAttachmentFileIds().Count > 0);

    private bool CanAttachFiles
        => SurfaceOptions.Value.EnableAgentChat
           && !_sending
           && Workspace.SelectedAgent is not null;

    private bool HasUploadingAttachments
        => _pendingAttachments.Any(attachment => attachment.IsUploading);

    private bool HasFailedAttachments
        => _pendingAttachments.Any(attachment => !string.IsNullOrWhiteSpace(attachment.Error));

    private bool MentionPickerOpen
        => Workspace.SelectedSquad is not null
           && _mentionActive
           && MentionCandidates().Count > 0;

    private string CommandCenterClass
        => LayoutMode.GetValueOrDefault(SurfaceOptions.Value.CommandCenterLayoutMode) == SurfaceCommandCenterLayoutMode.Embedded
            ? "surface-command-center surface-command-center-embedded"
            : "surface-command-center surface-command-center-standalone";

    private bool IsSquadSettingsTab
        => Workspace.SelectedSquad is not null
           && _selectedSquadTab == SurfaceSquadTab.Settings;

    private RenderFragment CreateAgentForm() => @<text>
        <div class="surface-create-body">
            @if (!string.IsNullOrWhiteSpace(Workspace.DiscoveryError))
            {
                <div class="surface-create-alert">@Workspace.DiscoveryError</div>
            }

            @if (Workspace.Discovery?.Collisions is { Count: > 0 } collisions)
            {
                <div class="surface-create-alert is-warning">
                    Discovery reported @collisions.Count alias collision@(collisions.Count == 1 ? string.Empty : "s").
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_createError))
            {
                <div class="surface-create-alert">@_createError</div>
            }

            <section class="surface-create-section">
                <h3>Identity</h3>
                <div class="surface-create-grid">
                    <label>
                        <span>Handle</span>
                        <input @bind="_createDraft.Handle" placeholder="assistant" />
                    </label>
                    <label>
                        <span>Agent type</span>
                        <input @bind="_createDraft.AgentType" placeholder="agent alias" />
                    </label>
                    <label>
                        <span>Model</span>
                        <input @bind="_createDraft.Models" placeholder="default" />
                    </label>
                    <label class="is-wide">
                        <span>Description</span>
                        <input @bind="_createDraft.Description" placeholder="What this agent is for" />
                    </label>
                </div>

                @if (Workspace.Discovery?.Agents.Count > 0)
                {
                    <div class="surface-discovery-list" aria-label="Discovered agent types">
                        @foreach (var agentType in Workspace.Discovery.Agents)
                        {
                            var alias = PrimaryAlias(agentType);
                            <button type="button"
                                    class="surface-discovery-choice @(string.Equals(_createDraft.AgentType, alias, StringComparison.OrdinalIgnoreCase) ? "is-selected" : "")"
                                    @onclick="() => SelectAgentType(alias)">
                                <span>@alias</span>
                                <small>@DiscoverySummary(agentType)</small>
                            </button>
                        }
                    </div>
                }
            </section>

            <section class="surface-create-section">
                <h3>Instructions</h3>
                <label>
                    <span>System prompt</span>
                    <textarea @bind="_createDraft.SystemPrompt" rows="5" placeholder="How should this agent behave?"></textarea>
                </label>
            </section>

            <section class="surface-create-section">
                <h3>Plugins</h3>
                <textarea @bind="_createDraft.PluginAliases" rows="3" placeholder="One plugin alias per line"></textarea>
                @if (Workspace.Discovery?.Plugins.Count > 0)
                {
                    <div class="surface-discovery-list" aria-label="Discovered plugins">
                        @foreach (var plugin in Workspace.Discovery.Plugins)
                        {
                            var alias = PrimaryAlias(plugin);
                            <button type="button"
                                    class="surface-discovery-choice @(_createDraft.HasPluginAlias(alias) ? "is-selected" : "")"
                                    @onclick="() => TogglePlugin(alias)">
                                <span>@alias</span>
                                <small>@DiscoverySummary(plugin)</small>
                            </button>
                        }
                    </div>
                }
            </section>

            <section class="surface-create-section">
                <h3>Tools</h3>
                <textarea @bind="_createDraft.ToolAliases" rows="3" placeholder="One tool alias per line"></textarea>
                @if (Workspace.Discovery?.Tools.Count > 0)
                {
                    <div class="surface-discovery-list" aria-label="Discovered tools">
                        @foreach (var tool in Workspace.Discovery.Tools)
                        {
                            var alias = PrimaryAlias(tool);
                            <button type="button"
                                    class="surface-discovery-choice @(_createDraft.HasToolAlias(alias) ? "is-selected" : "")"
                                    @onclick="() => ToggleTool(alias)">
                                <span>@alias</span>
                                <small>@DiscoverySummary(tool)</small>
                            </button>
                        }
                    </div>
                }
            </section>

            <section class="surface-create-section">
                <h3>Advanced</h3>
                <label>
                    <span>Streams</span>
                    <textarea @bind="_createDraft.Streams" rows="2" placeholder="One stream per line"></textarea>
                </label>
                <label class="surface-check-row">
                    <input type="checkbox" @bind="_createDraft.ForceReconfigure" />
                    <span>Force reconfigure if the handle already exists</span>
                </label>
            </section>

            <section class="surface-create-section">
                <div class="surface-create-section-title">
                    <h3>Args</h3>
                    <button type="button" @onclick="AddArgRow">Add arg</button>
                </div>
                <div class="surface-kv-list">
                    @foreach (var row in _createDraft.Args)
                    {
                        <div class="surface-kv-row" @key="row">
                            <input @bind="row.Key" placeholder="Key" />
                            <input @bind="row.Value" placeholder="Value" />
                            <button type="button" @onclick="() => RemoveArgRow(row)" aria-label="Remove arg">x</button>
                        </div>
                    }
                </div>
            </section>

            <section class="surface-create-section">
                <div class="surface-create-section-title">
                    <h3>MCP servers</h3>
                    <button type="button" @onclick="AddMcpServer">Add server</button>
                </div>
                @if (_createDraft.McpServers.Count == 0)
                {
                    <div class="surface-command-note">No MCP servers configured.</div>
                }
                @foreach (var server in _createDraft.McpServers)
                {
                    <div class="surface-mcp-editor" @key="server">
                        <div class="surface-create-grid">
                            <label>
                                <span>Name</span>
                                <input @bind="server.Name" placeholder="filesystem" />
                            </label>
                            <label>
                                <span>Transport</span>
                                <select @bind="server.TransportType">
                                    <option value="@McpTransportType.Stdio">Stdio</option>
                                    <option value="@McpTransportType.Http">Http</option>
                                </select>
                            </label>
                            <label>
                                <span>Command</span>
                                <input @bind="server.Command" placeholder="npx" />
                            </label>
                            <label>
                                <span>URL</span>
                                <input @bind="server.Url" placeholder="https://tools.example.com/mcp" />
                            </label>
                            <label class="is-wide">
                                <span>Arguments</span>
                                <textarea @bind="server.Arguments" rows="2" placeholder="One argument per line"></textarea>
                            </label>
                        </div>

                        <div class="surface-create-subgrid">
                            <div>
                                <div class="surface-create-section-title">
                                    <h4>Environment</h4>
                                    <button type="button" @onclick="() => AddKeyValueRow(server.Env)">Add</button>
                                </div>
                                @foreach (var row in server.Env)
                                {
                                    <div class="surface-kv-row" @key="row">
                                        <input @bind="row.Key" placeholder="Key" />
                                        <input @bind="row.Value" placeholder="Value" />
