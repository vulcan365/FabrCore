    private IEnumerable<SurfaceAgentSummary> ExistingAgentsForSelectedSquad()
    {
        var selected = Workspace.SelectedSquad;
        if (selected is null)
        {
            return [];
        }

        var existingHandles = selected.Agents.Select(agent => agent.Handle).ToHashSet(StringComparer.OrdinalIgnoreCase);
        existingHandles.Add(selected.OrchestratorHandle);

        return Workspace.AllAgents
            .Where(agent => !agent.IsHidden
                            && !existingHandles.Contains(agent.Handle)
                            && !string.Equals(agent.AgentType, SurfaceOrchestrationAgentTypes.SquadOrchestrator, StringComparison.OrdinalIgnoreCase))
            .OrderBy(agent => agent.DisplayName, StringComparer.OrdinalIgnoreCase);
    }

