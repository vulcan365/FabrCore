    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnWorkspaceChanged;
        _activeView = Workspace.ActivateSelectedTargetView();
        _principalContext = await PrincipalContextProvider.GetCurrentAsync();

        if (_principalContext.IsResolved)
        {
            await Workspace.InitializeAsync(_principalContext);
            ApplyTargetQuery();
            StartRefreshLoops();
        }

        _loading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loading && Workspace.IsInitialized)
        {
            ApplyTargetQuery();
        }

        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Workspace.SelectedAgent is null)
        {
            return;
        }

        try
        {
            _composerModule ??= await LoadSurfaceModuleAsync();
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await _composerModule.InvokeVoidAsync("bindSurfaceComposer", _composerRef, _dotNetRef);
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"Surface composer binding failed: {ex.Message}");
            return;
        }

        if (_timelineScrollRequested)
        {
            _timelineScrollRequested = false;
            await _composerModule.InvokeVoidAsync("scrollSurfaceTimelineToLatest", _timelineRef);
        }

        if (_composerFocusRequested)
        {
            _composerFocusRequested = false;
            await _composerModule.InvokeVoidAsync("focusSurfaceComposer", _composerRef);
        }
    }

    private void StartRefreshLoops()
    {
        _timerCts = new CancellationTokenSource();
        _agentTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _healthTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = RunAgentRefreshLoopAsync(_timerCts.Token);
        _ = RunHealthRefreshLoopAsync(_timerCts.Token);
    }

    private async ValueTask<IJSObjectReference> LoadSurfaceModuleAsync()
        => _composerModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/FabrCore.Surface/adaptiveCardsSurface.js");

    private async Task CopyMessageAsync(SurfaceTimelineItem item)
    {
        var module = await LoadSurfaceModuleAsync();
        await module.InvokeVoidAsync("copyTextToClipboard", MessageCopyText(item));

        _copiedMessageId = item.Id;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1200);

        if (string.Equals(_copiedMessageId, item.Id, StringComparison.Ordinal))
        {
            _copiedMessageId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsCopiedMessage(SurfaceTimelineItem item)
        => string.Equals(_copiedMessageId, item.Id, StringComparison.Ordinal);

    private static string MessageCopyText(SurfaceTimelineItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.Text))
        {
            return item.Text;
        }

        if (item.Envelope is not null)
        {
            return System.Text.Json.JsonSerializer.Serialize(item.Envelope, SurfaceJson.Options);
        }

        if (item.SourceMessage?.Data is { Length: > 0 } data)
        {
            return System.Text.Encoding.UTF8.GetString(data);
        }

        return item.MessageType ?? string.Empty;
    }

    private static string? MessageTokenUsageText(SurfaceTimelineItem item)
    {
        if (!TryGetMessageTokenUsage(item.SourceMessage, out var inputTokens, out var outputTokens))
        {
            return null;
        }

        return $"tokens: {FormatTokenCount(inputTokens)}/{FormatTokenCount(outputTokens)} in/out";
    }

    private static bool TryGetMessageTokenUsage(AgentMessage? message, out long inputTokens, out long outputTokens)
    {
        inputTokens = 0;
        outputTokens = 0;
        if (message is null)
        {
            return false;
        }

        var hasInput = TryGetLongMetadata(
            message,
            out inputTokens,
            "_tokens_input",
            "inputTokens",
            "InputTokens",
            "inputTokenCount",
            "InputTokenCount",
            "promptTokens",
            "PromptTokens",
            "ChatInputTokens");
        var hasOutput = TryGetLongMetadata(
            message,
            out outputTokens,
            "_tokens_output",
            "outputTokens",
            "OutputTokens",
            "outputTokenCount",
            "OutputTokenCount",
            "completionTokens",
            "CompletionTokens",
            "ChatOutputTokens");

        return hasInput || hasOutput;
    }

    private static bool TryGetLongMetadata(AgentMessage message, out long value, params string[] keys)
    {
        foreach (var key in keys)
        {
            if (TryGetLong(message.Args, key, out value))
            {
                return true;
            }
        }

        value = 0;
        return false;
    }

    private static bool TryGetLong(IReadOnlyDictionary<string, string>? metadata, string key, out long value)
    {
        value = 0;
        if (metadata is null)
        {
            return false;
        }

        if (!metadata.TryGetValue(key, out var raw) || string.IsNullOrWhiteSpace(raw))
        {
            return false;
        }

        return long.TryParse(raw, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out value);
    }

    private static string FormatTokenCount(long value)
        => value.ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    private async Task RunAgentRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_agentTimer is not null && await _agentTimer.WaitForNextTickAsync(cancellationToken))
            {
                await Workspace.RefreshAgentsAsync(cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RunHealthRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_healthTimer is not null && await _healthTimer.WaitForNextTickAsync(cancellationToken))
            {
                await Workspace.RefreshSelectedHealthAsync(cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAgentsAsync()
    {
        await Workspace.RefreshFromStorageAsync();
    }

    private void TogglePanelMenu()
        => _panelMenuOpen = !_panelMenuOpen;

    private void ClosePanelMenu()
        => _panelMenuOpen = false;

    private string SquadTabClass(SurfaceSquadTab tab)
        => _selectedSquadTab == tab ? "is-active" : string.Empty;

    private void SelectSquadTab(SurfaceSquadTab tab)
    {
        if (Workspace.SelectedSquad is null)
        {
            _selectedSquadTab = SurfaceSquadTab.Chat;
            return;
        }

        CloseMentionPicker();
        _selectedSquadTab = tab;
