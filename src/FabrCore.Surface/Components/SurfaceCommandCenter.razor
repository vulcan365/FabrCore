    private async Task SendAsync()
    {
        if (!CanSend)
        {
            return;
        }

        _sending = true;
        var message = _draft;
        var fileIds = ReadyAttachmentFileIds();
        _draft = string.Empty;
        _pendingAttachments.Clear();
        CloseMentionPicker();

        try
        {
            await Workspace.SendChatAsync(message, fileIds);
        }
        finally
        {
            _sending = false;
            _composerFocusRequested = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task SendComposerMessageAsync()
        => SendAsync();

    [JSInvokable]
    public Task HandleComposerMentionKeyAsync(string key)
    {
        if (!MentionPickerOpen)
        {
            return Task.CompletedTask;
        }

        var candidates = MentionCandidates();
        switch (key)
        {
            case "ArrowDown":
                _mentionSelectedIndex = (_mentionSelectedIndex + 1) % candidates.Count;
                break;
            case "ArrowUp":
                _mentionSelectedIndex = (_mentionSelectedIndex + candidates.Count - 1) % candidates.Count;
                break;
            case "Enter":
            case "Tab":
                SelectMention(candidates[Math.Clamp(_mentionSelectedIndex, 0, candidates.Count - 1)]);
                break;
            case "Escape":
                CloseMentionPicker();
                break;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

