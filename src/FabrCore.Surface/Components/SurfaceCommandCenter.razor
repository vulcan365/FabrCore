    private async Task OpenAddExistingAgentAsync()
    {
        await Workspace.RefreshAgentsAsync();
        _squadAgentMode = "existing";
        _squadAgentError = null;
        _squadSettingsError = null;
        _existingAgentHandle = ExistingAgentsForSelectedSquad().FirstOrDefault()?.Handle ?? string.Empty;
        _existingAgentName = string.Empty;
        _existingAgentRole = SurfaceSquadMemberRole.Executor;
    }

    private async Task OpenCreateSquadAgentAsync()
    {
        await Workspace.LoadDiscoveryAsync(forceRefresh: true);
        _squadAgentMode = "create";
        _squadAgentError = null;
        _squadSettingsError = null;
        _squadAgentDraft = new SurfaceSquadAgentDraft();
        _squadAgentDraft.Role = SurfaceSquadMemberRole.Executor;
        if (SquadMemberAgentTypes().FirstOrDefault() is { } firstAgent)
        {
            _squadAgentDraft.AgentType = PrimaryAlias(firstAgent);
        }
    }

    private void CloseSquadAgentDialog()
    {
        if (_squadAgentBusy)
        {
            return;
        }

        _squadAgentMode = null;
        _squadAgentError = null;
        _existingAgentHandle = string.Empty;
        _existingAgentName = string.Empty;
        _existingAgentRole = SurfaceSquadMemberRole.Executor;
    }

    private async Task SaveSquadAgentAsync()
    {
        _squadAgentBusy = true;
        _squadAgentError = null;

        try
        {
            if (_squadAgentMode == "existing")
            {
                await Workspace.AddExistingAgentToSelectedSquadAsync(_existingAgentHandle, _existingAgentName, _existingAgentRole);
            }
            else
            {
                await Workspace.CreateAgentForSelectedSquadAsync(_squadAgentDraft.Build());
            }

            CloseSquadAgentDialog();
        }
        catch (Exception ex)
        {
            _squadAgentError = ex.Message;
        }
        finally
        {
            _squadAgentBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsRemovingSquadAgent(string handle)
        => string.Equals(_removingSquadAgentHandle, handle, StringComparison.OrdinalIgnoreCase);

    private async Task RemoveSquadAgentAsync(SurfaceSquadAgent agent)
    {
        if (_removingSquadAgentHandle is not null)
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Remove {agent.Name} from this squad?");
        if (!confirmed)
        {
            return;
        }

        _squadSettingsError = null;
        _removingSquadAgentHandle = agent.Handle;

        try
        {
            await Workspace.RemoveAgentFromSelectedSquadAsync(agent.Handle);
        }
        catch (Exception ex)
        {
            _squadSettingsError = ex.Message;
        }
        finally
        {
            _removingSquadAgentHandle = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenCreateAgentAsync()
    {
        _createError = null;
        await Workspace.LoadDiscoveryAsync();

        if (string.IsNullOrWhiteSpace(_createDraft.AgentType)
            && Workspace.Discovery?.Agents.FirstOrDefault() is { } firstAgent)
        {
            _createDraft.AgentType = PrimaryAlias(firstAgent);
        }
    }

    private void CloseCreateAgent()
    {
        if (_createBusy)
        {
            return;
        }

        _createError = null;

        if (IsCreateRoute)
        {
            Navigation.NavigateTo("/surface", forceLoad: true);
        }
    }

    private async Task CreateAgentAsync()
    {
        _createBusy = true;
        _createError = null;

        try
        {
            var config = _createDraft.Build();
            await Workspace.CreateAgentAsync(config);
            _createDraft = new SurfaceAgentConfigurationDraft();
            _composerFocusRequested = true;
            if (IsCreateRoute)
            {
                Navigation.NavigateTo("/surface", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            _createError = ex.Message;
        }
        finally
        {
            _createBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

