@using System.Text.Json
@using FabrCore.Surface.Templating
@using FabrCore.Surface.Validation
@inject AdaptiveCardSurfaceValidator Validator
@inject ISurfaceActionDispatcher Dispatcher
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Options.IOptions<SurfaceOptions> SurfaceOptions
@inject Microsoft.Extensions.Logging.ILogger<SurfaceAdaptiveCardHost> Logger
@implements IAsyncDisposable

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="fabrcore-surface-alert">@_error</div>
}
else if (_validation is { IsValid: false })
{
    <div class="fabrcore-surface-alert">@string.Join(" ", _validation.Errors)</div>
}
else
{
    <div class="surface-card-frame @(_isCompact ? "is-compact" : "")">
        <div class="fabrcore-surface-card-host surface-command-card-host" @ref="_container"></div>
        @if (_isCompact)
        {
            <div class="surface-card-fade"></div>
            <button type="button" class="surface-card-expand" @onclick="OpenExpandedAsync">
                Expand card
            </button>
        }
    </div>

    @if (_isExpanded)
    {
        <div class="surface-card-modal" role="dialog" aria-modal="true" aria-label="Adaptive card preview">
            <div class="surface-card-modal-backdrop" @onclick="CloseExpanded"></div>
            <section class="surface-card-modal-panel">
                <header class="surface-card-modal-header">
                    <h2>Adaptive card</h2>
                    <button type="button" class="surface-card-modal-close" @onclick="CloseExpanded" aria-label="Close expanded card">Close</button>
                </header>
                <div class="fabrcore-surface-card-host surface-card-modal-host" @ref="_expandedContainer"></div>
            </section>
        </div>
    }
}

@code {
    private const int DefaultInlineMaxHeight = 420;

    private ElementReference _container;
    private ElementReference _expandedContainer;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SurfaceAdaptiveCardHost>? _dotNetRef;
    private AdaptiveCardSurfaceValidationResult? _validation;
    private JsonElement _expandedCard;
    private bool _rendered;
    private bool _expandedRendered;
    private bool _isCompact;
    private bool _isExpanded;
    private string? _renderedEnvelopeId;
    private string? _error;

    [Parameter, EditorRequired]
    public AdaptiveCardSurfaceEnvelope Envelope { get; set; } = new();

    [Parameter]
    public AgentMessage? SourceMessage { get; set; }

    [Parameter]
    public ISurfacePrincipalContext? PrincipalContext { get; set; }

    [Parameter]
    public int InlineMaxHeight { get; set; } = DefaultInlineMaxHeight;

    protected override void OnParametersSet()
    {
        if (string.Equals(_renderedEnvelopeId, Envelope.Id, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _validation = Validator.Validate(Envelope);
        if (_validation.IsValid)
        {
            _expandedCard = AdaptiveCardTemplateExpander.Expand(Envelope.Card, Envelope.Data);
        }

        _rendered = false;
        _expandedRendered = false;
        _isCompact = false;
        _isExpanded = false;
        _renderedEnvelopeId = Envelope.Id;
        _error = null;
        _dotNetRef ??= DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_validation is not { IsValid: true })
        {
            return;
        }

        try
        {
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/FabrCore.Surface/adaptiveCardsSurface.js");

            if (!_rendered)
            {
                await _module.InvokeVoidAsync(
                    "renderAdaptiveCard",
                    _container,
                    Envelope.Id,
                    _expandedCard,
                    _dotNetRef);
                _rendered = true;

                if (InlineMaxHeight > 0)
                {
                    var height = await _module.InvokeAsync<int>("getRenderedHeight", _container);
                    if (height > InlineMaxHeight)
                    {
                        _isCompact = true;
                        StateHasChanged();
                    }
                }
            }

            if (_isExpanded && !_expandedRendered)
            {
                await _module.InvokeVoidAsync(
                    "renderAdaptiveCard",
                    _expandedContainer,
                    $"{Envelope.Id}-expanded",
                    _expandedCard,
                    _dotNetRef);
                _expandedRendered = true;
            }
        }
        catch (Exception ex)
        {
            _error = $"Unable to render Surface card: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task OpenExpandedAsync()
    {
        _isExpanded = true;
        _expandedRendered = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseExpanded()
    {
        _isExpanded = false;
        _expandedRendered = false;
    }

    [JSInvokable]
    public async Task OnAdaptiveCardActionAsync(string envelopeId, JsonElement action, JsonElement inputs)
    {
        if (PrincipalContext is null || SourceMessage is null)
        {
            return;
        }

        var surfaceAction = new AdaptiveCardSurfaceAction
        {
            Type = ReadString(action, "type") ?? AdaptiveCardActionTypes.Execute,
            Title = ReadString(action, "title"),
            Verb = ReadString(action, "verb"),
            Url = ReadString(action, "url"),
            Data = action.TryGetProperty("data", out var data) ? data.Clone() : null,
            Inputs = ReadInputs(inputs)
        };

        await Dispatcher.DispatchAsync(
            new SurfaceActionContext
            {
                Envelope = Envelope,
                PrincipalContext = PrincipalContext,
                SourceMessage = SourceMessage
            },
            surfaceAction);
    }

    [JSInvokable]
    public Task OnAdaptiveCardRenderedAsync(string envelopeId, int renderedActionCount)
    {
        if (SourceMessage is not null && SurfaceOptions.Value.EnableDiagnostics)
        {
            SourceMessage.Args ??= new Dictionary<string, string>();
            SourceMessage.Args[SurfaceDiagnosticArgs.RenderedActionCount] = renderedActionCount.ToString();
            Logger.LogInformation(
                "Surface command center rendered card {EnvelopeId} with {RenderedActionCount} visible actions.",
                envelopeId,
                renderedActionCount);
        }

        return Task.CompletedTask;
    }

    private static string? ReadString(JsonElement element, string propertyName)
        => element.ValueKind == JsonValueKind.Object
           && element.TryGetProperty(propertyName, out var property)
           && property.ValueKind == JsonValueKind.String
            ? property.GetString()
            : null;

    private static Dictionary<string, object?> ReadInputs(JsonElement inputs)
    {
        var values = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        if (inputs.ValueKind != JsonValueKind.Object)
        {
            return values;
        }

        foreach (var property in inputs.EnumerateObject())
        {
            values[property.Name] = JsonElementToObject(property.Value);
        }

        return values;
    }

    private static object? JsonElementToObject(JsonElement element)
        => element.ValueKind switch
        {
            JsonValueKind.String => element.GetString(),
            JsonValueKind.Number when element.TryGetInt64(out var longValue) => longValue,
            JsonValueKind.Number when element.TryGetDouble(out var doubleValue) => doubleValue,
            JsonValueKind.True => true,
            JsonValueKind.False => false,
            JsonValueKind.Null => null,
            JsonValueKind.Object => element.EnumerateObject()
                .ToDictionary(p => p.Name, p => JsonElementToObject(p.Value), StringComparer.OrdinalIgnoreCase),
            JsonValueKind.Array => element.EnumerateArray().Select(JsonElementToObject).ToList(),
            _ => element.Clone()
        };

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
