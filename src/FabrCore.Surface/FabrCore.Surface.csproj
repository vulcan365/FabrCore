<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Title>FabrCore Surface</Title>
		<Description>Agent-driven UI intent surface for FabrCore Blazor applications</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\FabrCore.Client.Orleans\FabrCore.Client.Orleans.csproj" />
		<ProjectReference Include="..\FabrCore.Sdk\FabrCore.Sdk.csproj" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.Orleans.Client" Version="10.3.1" />
		<PackageReference Include="Microsoft.Orleans.Streaming" Version="10.3.1" />
		<PackageReference Include="AdaptiveCards" Version="3.1.0" />
		<PackageReference Include="Markdig" Version="1.3.2" />
	</ItemGroup>


	<ItemGroup>
		<!-- The consuming app owns the deployed profile; keep this file as a package template. -->
		<Content Update="fabrcore-surface.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
	</ItemGroup>

</Project>
