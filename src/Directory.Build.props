<Project>
  <PropertyGroup>
    <Authors>Vulcan365 LLC</Authors>
    <Company>Vulcan365 LLC</Company>
    <Copyright>Copyright (c) 2025 Vulcan365 LLC</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vulcan365/FabrCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/vulcan365/FabrCore</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.5</MinVerMinimumMajorMinor>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <FabrCorePublicApi Condition="'$(MSBuildProjectName)' == 'FabrCore.Core' Or '$(MSBuildProjectName)' == 'FabrCore.Sdk' Or '$(MSBuildProjectName)' == 'FabrCore.Host' Or '$(MSBuildProjectName)' == 'FabrCore.Host.AzureStorage' Or '$(MSBuildProjectName)' == 'FabrCore.Host.Testing' Or '$(MSBuildProjectName)' == 'FabrCore.Client.Orleans' Or '$(MSBuildProjectName)' == 'FabrCore.Client.WebSocket' Or '$(MSBuildProjectName)' == 'FabrCore.Services.Microsoft365Copilot' Or '$(MSBuildProjectName)' == 'FabrCore.Surface'">true</FabrCorePublicApi>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FabrCore.Connections' Or '$(MSBuildProjectName)' == 'FabrCore.Services.Connections' Or '$(MSBuildProjectName)' == 'FabrCore.Services.RemoteAgents'">
    <FabrCorePublicApi>true</FabrCorePublicApi>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FabrCorePublicApi)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0024;RS0025</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(FabrCorePublicApi)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
