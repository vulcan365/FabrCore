{
  // The same blueprint can be applied locally, stored by the host, or distributed by Forge.
  "name": "my-local-team",
  "description": "Copy-me FabrCore blueprint",
  "version": "1",
  "agents": [
    {
      // Handles without a principal prefix are scoped to x-user-handle at apply time.
      "handle": "assistant",
      "agentType": "surface",
      "models": "default",
      "description": "A general-purpose assistant",
      "systemPrompt": "Help the user clearly and concisely.",
      "plugins": [],
      "tools": [],
      "args": {}
    }
  ],
  "squads": [
    {
      "squadType": "task",
      "name": "Research Desk",
      "description": "Plans and delegates multi-step research to squad executors.",
      "orchestratorModel": "default",
      "agents": [
        {
          // Reuse the blueprint-defined assistant instead of creating another agent.
          "handle": "assistant",
          "name": "Researcher",
          "agentType": "surface",
          "role": "executor"
        }
      ]
    }
  ]
}
