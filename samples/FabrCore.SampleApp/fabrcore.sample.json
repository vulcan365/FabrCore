{
  "ModelConfigurations": [
    {
      "Name": "default",
      "Provider": "OpenAI",
      "Model": "gpt-4o",
      "ApiKeyAlias": "openai",
      "ContextWindowTokens": 128000,
      "MaxOutputTokens": 8192
    },
    {
      "Name": "embeddings",
      "Provider": "OpenAI",
      "Model": "text-embedding-3-small",
      "ApiKeyAlias": "openai"
    },
    {
      "Name": "graphrag",
      "Provider": "OpenAI",
      "Model": "gpt-5.4-mini",
      "ApiKeyAlias": "openai",
      "ReasoningEffort": "none",
      "ContextWindowTokens": 75000,
      "MaxOutputTokens": 8192
    }
  ],
  "ApiKeys": [
    {
      "Alias": "openai",
      "Value": "replace-with-api-key"
    }
  ],
  "AgentBindings": {
    "assistant": {
      "AgentType": "crm-demo-agent",
      "Handle": "assistant",
      "Models": "default"
    }
  },
  "A2A": {
    "Enabled": false,
    "PublicBaseUrl": "https://replace-with-public-host",
    "Agents": [
      {
        "Name": "crm-assistant",
        "Binding": "assistant"
      }
    ],
    "Principal": {
      "Strategy": "CanonicalEntra"
    },
    "Authentication": {
      "Mode": "JwtBearer",
      "JwtBearer": {
        "Authority": "https://login.microsoftonline.com/replace-with-entra-tenant-id/v2.0",
        "Audience": "replace-with-a2a-api-app-client-id",
        "RequiredScopes": [
          "agent.invoke"
        ]
      }
    },
    "Provider": {
      "Organization": "Vulcan365",
      "Url": "https://vulcan365.com"
    }
  },
  "Microsoft365Copilot": {
    "TenantId": "replace-with-entra-tenant-id",
    "ClientId": "replace-with-bot-app-registration-client-id",
    "ClientSecret": "<set-with-user-secrets-or-key-vault>",
    "WelcomeMessage": "Hello! I'm the FabrCore Surface CRM demo agent. Ask me about the Contoso CRM data.",
    "Principal": {
      "Strategy": "CanonicalEntra"
    },
    "Agent": {
      "Binding": "assistant"
    },
    "Proactive": {
      "Enabled": true,
      "AllowedConversationTypes": [
        "personal"
      ]
    },
    "Manifest": {
      "Name": "FabrCore Surface Demo",
      "FullName": "FabrCore SurfaceApp CRM Demo Agent",
      "Description": "Chat with the FabrCore SurfaceApp CRM demo agent.",
      "FullDescription": "Custom engine agent that bridges Microsoft 365 Copilot and Teams to the FabrCore SurfaceApp CRM demo agents running on Orleans.",
      "DeveloperName": "Vulcan365",
      "WebsiteUrl": "https://vulcan365.com",
      "PrivacyUrl": "https://vulcan365.com",
      "TermsOfUseUrl": "https://vulcan365.com",
      "PublicHostName": "replace-with-public-host",
      "ConversationStarters": [
        {
          "Title": "Browse accounts",
          "Description": "What CRM accounts do we have?"
        },
        {
          "Title": "Pipeline check",
          "Description": "Summarize the current sales opportunities."
        }
      ]
    }
  }
}
