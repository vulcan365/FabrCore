{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Orleans": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FabrCore": {
    "HostUrl": "http://localhost:5000",
    "Orleans": {
      "ClusterId": "dev",
      "ServiceId": "fabrcore",
      "ClusteringMode": "Localhost"
    },
    "Acl": {
      "SystemPrincipal": "system",
      "Mode": "Enforce",
      "SeedDefaultSystemAgentAccess": true
    }
  }
}
