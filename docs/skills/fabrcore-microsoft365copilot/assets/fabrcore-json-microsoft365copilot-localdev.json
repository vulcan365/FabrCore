{
  "ModelConfigurations": [
    {
      "Name": "default",
      "Provider": "OpenAI",
      "Model": "gpt-4o-mini",
      "ApiKeyAlias": "openai"
    }
  ],
  "ApiKeys": [
    {
      "Alias": "openai",
      "Value": "replace-with-api-key"
    }
  ],
  "Microsoft365Copilot": {
    "TokenValidation": { "Enabled": false },
    "Agents": [
      {
        "Name": "assistant",
        "Route": "/api/messages",
        "AgentType": "replace-with-your-agent-alias",
        "Handle": "copilot",
        "Models": "default"
      }
    ]
  }
}
